{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ion-cascade/stereograph/blob/v0.6.0/docs/motion-review.schema.json",
  "title": "Stereograph Motion Review Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "frames", "surfaces", "rules"],
  "properties": {
    "version": {"const": 1},
    "name": {"$ref": "#/$defs/name"},
    "frames": {"$ref": "#/$defs/frames"},
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step": {"type": "number", "minimum": 0.001, "maximum": 1, "default": 1},
        "refine_step": {"type": "number", "minimum": 0.001, "maximum": 1},
        "near_gap": {"$ref": "#/$defs/gap", "default": 0.001}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "object"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "object": {"$ref": "#/$defs/name"}}
    },
    "surfaces": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/surface"}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "gap": {"type": "number", "minimum": 0, "maximum": 1000000},
    "frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number", "minimum": -1048574, "maximum": 1048574}
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object"],
      "dependentRequired": {"minimum_weight": ["vertex_group"]},
      "properties": {
        "object": {"$ref": "#/$defs/name"},
        "material": {"$ref": "#/$defs/name"},
        "vertex_group": {"$ref": "#/$defs/name"},
        "minimum_weight": {"type": "number", "minimum": 0.001, "maximum": 1, "default": 0.5}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pair", "mode"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "mode": {"enum": ["clear", "allowed", "required"]},
        "frames": {"$ref": "#/$defs/frames"},
        "gap": {"$ref": "#/$defs/gap"},
        "check_containment": {"type": "boolean", "default": false}
      },
      "if": {"properties": {"mode": {"const": "allowed"}}},
      "then": {"not": {"required": ["gap"]}}
    }
  }
}
